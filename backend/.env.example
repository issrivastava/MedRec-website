# Copy to .env and fill in
DATABASE_URL=postgresql+psycopg2://medrec:medrec@localhost:5432/medrec
# For quick local dev without Postgres, use sqlite:
# DATABASE_URL=sqlite:///./medrec.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
VIDEO_MAX_UPLOAD_MB=100
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=120
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000
# Firebase login (service-account JSON from Firebase console -> Project settings -> Service accounts)
# Empty = Firebase login disabled, local login still works for dev.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Admin registration key (register with role=admin + this admin_key). Empty = disabled.
ADMIN_SIGNUP_KEY=
# Email delivery (OTP codes + notifications) via SMTP. Empty = in-app only
# (no OTP is delivered; the code is only printed to the backend console log).
# To really mail OTPs with Gmail:
#   1. Google Account -> Security -> 2-Step Verification ON
#   2. Search "App passwords" -> create one for "Mail"
#   3. MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER=you@gmail.com,
#      MAIL_PASSWORD=<16-letter app password>, MAIL_FROM=MedRec <you@gmail.com>
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=MedRec <noreply@example.com>
# Optional SMS (OTP codes are sent by SMS *and* email — same code, both channels).
# Point this at any HTTP→SMS forwarder that accepts POST {"to","message"} and
# returns 2xx. Examples: a tiny Fast2SMS/MSG91/Twilio bridge script.
# Empty = no SMS (codes go by email only; in dev they show on screen).
SMS_WEBHOOK_URL=
# Country prefix auto-added to bare 10-digit numbers (India default).
SMS_DEFAULT_PREFIX=+91
# Email OTP (forgot password + passwordless login). The code is always
# printed to the backend console log; it is NEVER returned to the browser
# unless you explicitly set OTP_DEV_ECHO=True for local testing.
# Keep OTP_DEV_ECHO=False in production.
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=False
# --- Medicine Description tab (FREE, works with everything blank) ---
# Best free drug-data API: openFDA (https://open.fda.gov). No key needed;
# optional free key at https://open.fda.gov/apis/authentication/ raises limits.
OPENFDA_API_KEY=
# Tata 1mg has NO official public API — results link to Tata 1mg search pages.
# Only set these if you have an UNOFFICIAL Tata 1mg proxy (e.g. RapidAPI mirror).
TATA1MG_API_KEY=
TATA1MG_API_URL=
# --- AI doubt-solver ("Ask AI" chat). FREE tier, works with everything blank
# if Ollama is running; add a Gemini key for better answers ---
# Free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# --- Security & compliance ops (health data) ---
# Serve ONLY over HTTPS in production (TLS terminates at nginx/load balancer).
# Postgres at rest: enable disk/volume encryption + daily backups via
#   .venv\Scripts\python scripts\backup.py --out .\backups
# (see backend/scripts/backup.py). JWT expiry above = absolute session cap;
# frontend VITE_SESSION_TIMEOUT_MIN adds idle auto-logout. OTP 2-step login is
# enforced whenever MAIL_*/SMS_* delivery is configured.
# --- Clinic ops: UPI collect + automatic reminders ---
# Clinic UPI ID (VPA) shown on invoices for pay-by-UPI. Empty = UPI off.
CLINIC_UPI_ID=
# Hourly daemon tick sends tomorrow's appointment reminders + due medicine
# nudges (in-app + SMS when configured). Set False to disable.
AUTO_REMINDERS=True
# --- Clinic branding: printed header/footer on ALL generated PDFs ---
# Header = logo + name; footer = support email + working hours + copyright.
# These are defaults — an admin can override them at runtime in the
# Admin Panel ("PDF header & footer"), which applies instantly to new PDFs.
CLINIC_NAME=MedRec Clinic
CLINIC_ADDRESS=
CLINIC_SUPPORT_EMAIL=support@medrec.example.com
CLINIC_TIMINGS=Mon–Sat, 10:00 AM – 8:00 PM
# Path to a PNG/JPG logo file. Empty = teal cross mark is drawn instead.
CLINIC_LOGO_PATH=
