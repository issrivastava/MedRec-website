# Copy to .env and fill in
DATABASE_URL=postgresql+psycopg2://medrec:medrec@localhost:5432/medrec
# For quick local dev without Postgres, use sqlite:
# DATABASE_URL=sqlite:///./medrec.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
VIDEO_MAX_UPLOAD_MB=100
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=120
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Firebase login (service-account JSON from Firebase console -> Project settings -> Service accounts)
# Empty = Firebase login disabled, local login still works for dev.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Admin registration key (register with role=admin + this admin_key). Empty = disabled.
ADMIN_SIGNUP_KEY=
# Email delivery (OTP codes + notifications) via SMTP. Empty = in-app only
# (OTP codes are then shown on screen as `dev_code` for local dev).
# To really mail OTPs with Gmail:
#   1. Google Account -> Security -> 2-Step Verification ON
#   2. Search "App passwords" -> create one for "Mail"
#   3. MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER=you@gmail.com,
#      MAIL_PASSWORD=<16-letter app password>, MAIL_FROM=MedRec <you@gmail.com>
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=MedRec <noreply@example.com>
# Optional SMS webhook (POST {"to","message"}). Empty = no SMS.
SMS_WEBHOOK_URL=
# Email OTP (forgot password + passwordless login). Works without SMTP in dev:
# the code is logged to the backend console and echoed as `dev_code`.
# Set MAIL_* + OTP_DEV_ECHO=False in production.
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=True
# --- Medicine Description tab (FREE, works with everything blank) ---
# Best free drug-data API: openFDA (https://open.fda.gov). No key needed;
# optional free key at https://open.fda.gov/apis/authentication/ raises limits.
OPENFDA_API_KEY=
# Tata 1mg has NO official public API — results link to Tata 1mg search pages.
# Only set these if you have an UNOFFICIAL Tata 1mg proxy (e.g. RapidAPI mirror).
TATA1MG_API_KEY=
TATA1MG_API_URL=
# --- AI doubt-solver ("Ask AI" chat). FREE tier, works with everything blank
# if Ollama is running; add a Gemini key for better answers ---
# Free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
