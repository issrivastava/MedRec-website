# Copy to .env and fill in
DATABASE_URL=postgresql://postgres:bluepanda@localhost:5432/medrec
# For quick local dev without Postgres, use sqlite:
# DATABASE_URL=sqlite:///./medrec.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=120
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Firebase login (service-account JSON from Firebase console -> Project settings -> Service accounts)
# Empty = Firebase login disabled, local login still works for dev.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
