# Emergency number shown in the banner on every page (default 102, India ambulance).
VITE_EMERGENCY_NUMBER=102
# WhatsApp chat button (digits only, with country code, e.g. 919876543210). Empty = hidden.
VITE_WHATSAPP_NUMBER=
